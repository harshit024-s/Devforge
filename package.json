{
  "name": "mini-elearning-api",
  "version": "1.0.0",
  "description": "E-Learning Platform API — Express + Prisma + PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "npx prisma generate",
